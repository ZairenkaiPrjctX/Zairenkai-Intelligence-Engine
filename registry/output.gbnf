root ::= ws out
out-language ::= "\"id\"" | "\"en\"" | "\"other\""
out-goal ::= "\"" char{0,200} "\""
out-confidence-percent ::= "0" | [1-9] | [1-9] [0-9] | "100"
out-calls-item-0-tool ::= "\"core.health\""
out-calls-item-0-arguments ::= "{" ws "}" ws
out-calls-item-0 ::= "{" ws "\"tool\"" ws ":" ws out-calls-item-0-tool ws "," ws "\"arguments\"" ws ":" ws out-calls-item-0-arguments ws "}" ws
out-calls-item-1-tool ::= "\"core.capabilities\""
out-calls-item-1-arguments ::= "{" ws "}" ws
out-calls-item-1 ::= "{" ws "\"tool\"" ws ":" ws out-calls-item-1-tool ws "," ws "\"arguments\"" ws ":" ws out-calls-item-1-arguments ws "}" ws
out-calls-item-2-tool ::= "\"thermal.snapshot\""
out-calls-item-2-arguments ::= "{" ws "}" ws
out-calls-item-2 ::= "{" ws "\"tool\"" ws ":" ws out-calls-item-2-tool ws "," ws "\"arguments\"" ws ":" ws out-calls-item-2-arguments ws "}" ws
out-calls-item-3-tool ::= "\"fas.status\""
out-calls-item-3-arguments ::= "{" ws "}" ws
out-calls-item-3 ::= "{" ws "\"tool\"" ws ":" ws out-calls-item-3-tool ws "," ws "\"arguments\"" ws ":" ws out-calls-item-3-arguments ws "}" ws
out-calls-item-4-tool ::= "\"tuning.telemetry\""
out-calls-item-4-arguments ::= "{" ws "}" ws
out-calls-item-4 ::= "{" ws "\"tool\"" ws ":" ws out-calls-item-4-tool ws "," ws "\"arguments\"" ws ":" ws out-calls-item-4-arguments ws "}" ws
out-calls-item-5-tool ::= "\"fas.set_profile\""
out-calls-item-5-arguments-profile ::= "\"power_saver\"" | "\"balanced\"" | "\"performance\"" | "\"fast_response\"" | "\"adaptive\""
out-calls-item-5-arguments ::= "{" ws "\"profile\"" ws ":" ws out-calls-item-5-arguments-profile ws "}" ws
out-calls-item-5 ::= "{" ws "\"tool\"" ws ":" ws out-calls-item-5-tool ws "," ws "\"arguments\"" ws ":" ws out-calls-item-5-arguments ws "}" ws
out-calls-item ::= out-calls-item-0 | out-calls-item-1 | out-calls-item-2 | out-calls-item-3 | out-calls-item-4 | out-calls-item-5
out-calls ::= "[" ws (out-calls-item ("," ws out-calls-item){0,2})? "]" ws
out-clarification ::= "\"" char{0,200} "\""
out ::= "{" ws "\"language\"" ws ":" ws out-language ws "," ws "\"goal\"" ws ":" ws out-goal ws "," ws "\"confidence_percent\"" ws ":" ws out-confidence-percent ws "," ws "\"calls\"" ws ":" ws out-calls ws "," ws "\"clarification\"" ws ":" ws out-clarification ws "}" ws
ws ::= [ \t\n]{0,8}
char ::= [^"\\\x7F\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
